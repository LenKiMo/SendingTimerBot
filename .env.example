# ============================================================
# SendingTimeBot 配置模板
# 使用方法：复制本文件为 .env 并填写必填项
#   （Windows: copy .env.example .env   |   Linux/macOS: cp .env.example .env）
# 所有文件均为 UTF-8 编码。
# 优先级：系统环境变量 > 本文件。
# ============================================================

# ---- 必填 ----------------------------------------------------
# Bot Token：找 @BotFather 用 /newbot 创建机器人后获取（形如 123456789:AA...）
BOT_TOKEN=

# ---- 可选 ----------------------------------------------------
# 允许使用命令的用户 ID 白名单（逗号分隔；留空 = 任何人可用）
# ALLOWED_USER_IDS=123456789,987654321

# 调度线程检查间隔（秒），一般无需修改
# CHECK_INTERVAL_S=0.5

# 队列上限（条），防止消息无限堆积
# MAX_QUEUE=10000

# 上传文件大小上限（字节，默认 5MB = 5242880）
# MAX_FILE_BYTES=5242880

# 单个文件最多解析行数
# MAX_FILE_LINES=5000

# 状态数据目录（每用户一个队列状态文件，Docker 下已挂载 ./data 卷，无需修改）
# DATA_DIR=data

# Telegram API 地址（无需修改；测试/特殊代理场景可覆盖）
# API_BASE_URL=https://api.telegram.org

# API 请求失败重试次数
# MAX_RETRIES=3

# ---- 防滥用（默认值即安全默认，无需修改）------------------------
# 是否允许向私人用户定时发送消息（默认 false = 禁止；开启后仍需该用户
# 已与 bot 建立会话，Telegram 平台禁止 bot 主动联系未交互过的用户）
# ALLOW_PRIVATE_TARGETS=false

# 群组审批请求有效期（秒，默认 3600 = 60 分钟）
# 非群管理员的 /set 需目标群管理员在群内 /approve 后才生效
# PENDING_APPROVAL_SECONDS=3600

# 循环发送单次展开的消息总数上限（防滥用，默认 5000）
# MAX_LOOP_ITEMS=5000

# 每名用户最大并行队列数（每个目标一条队列，防滥用，默认 10）
# MAX_QUEUES_PER_USER=10

# 自动清理空闲队列间隔（秒，默认 86400 = 24 小时）
# GC_IDLE_SECONDS=86400

# /list 每页显示条数（默认 20）
# LIST_PAGE_SIZE=20

# /setloop 内容收集超时（秒，默认 120 = 2 分钟，无新内容自动开始循环）
# LOOP_COLLECT_TIMEOUT=120

# 时区（显示定时时间用；Docker 与本地均生效）
# TZ=Asia/Shanghai
